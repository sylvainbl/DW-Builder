    {
      "id": "disorder-effects",
      "title": "Effects of Disorder",
      "printedPage": 57,
      "pdfPage": 59,
      "bbox": [
        56.69,
        98.44,
        289.13,
        290.66
      ],
      "rows": [
        [
          "Demoralised\nAll Levels",
          "Each level of Disorder a model has imposes a\n-1 Modifier on its Crew rating.\nFor example, a model with a Crew rating of 7 has 2 levels\nof Disorder, so its Crew rating is treated as being 5."
        ],
        [
          "Panicking\nLevel 2",
          "If an Action Roll is made for a model with 2\nlevels of Disorder, any Heavy Strikes in the\nroll are Converted to Standard Strikes after\nRe-rolls have been resolved."
        ],
        [
          "Mutinous\nLevel 3",
          "If an Action Roll is made for a model with 3\nlevels of Disorder, any Heavy and Exploding\nStrikes in the roll are Converted to Standard\nStrikes after Re-rolls have been resolved.\nIf the model makes a Full Reverse or\nEmergency Manoeuvre, it gains a point of\nDamage instead of a level of Disorder."
        ]
      ],
