{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tokens",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentId",
    "tokens",
    "criticalDamageEffects"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "documentId": {
      "type": "string"
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": true
      }
    },
    "criticalDamageEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "text"
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
